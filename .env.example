# Database (Supabase PostgreSQL)
# Transaction pooler — use for the app (Prisma + serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection — use for migrations / db push
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin emails (comma-separated — these get admin role on first login)
ADMIN_EMAILS="you@example.com"

# Upload config
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE_MB=10

# UploadThing (optional — set NEXT_PUBLIC_USE_UPLOADTHING=true to enable)
NEXT_PUBLIC_USE_UPLOADTHING=false
UPLOADTHING_TOKEN="your-uploadthing-token"
