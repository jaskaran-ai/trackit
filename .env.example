# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/trackit?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin emails (comma-separated — these get admin role on first login)
ADMIN_EMAILS="you@example.com"

# Upload config
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE_MB=10

# UploadThing (optional — set NEXT_PUBLIC_USE_UPLOADTHING=true to enable)
UPLOADTHING_TOKEN="your-uploadthing-token"
NEXT_PUBLIC_USE_UPLOADTHING=false
